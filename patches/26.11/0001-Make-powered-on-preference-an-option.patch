index 8b5041e5eb..2f1c536725 100644
--- a/src/plugins/data_parser/v0.0.44/parsers.c
+++ b/src/plugins/data_parser/v0.0.44/parsers.c
@@ -10237,6 +10237,7 @@ static const flag_bit_t PARSER_FLAG_ARRAY(CR_TYPE)[] = {
 	add_flag_bit(SELECT_ONE_TASK_PER_CORE, "ONE_TASK_PER_CORE"),
 	add_flag_bit(SELECT_PACK_NODES, "PACK_NODES"),
 	add_flag_bit(SELECT_CORE_DEFAULT_DIST_BLOCK, "CORE_DEFAULT_DIST_BLOCK"),
+	add_flag_bit(SELECT_PREFER_POWERED_UP_NODES, "PreferPoweredUpNodes"),
 	add_flag_bit(SELECT_LLN, "LLN"),
 	add_flag_bit(SELECT_LINEAR, "LINEAR"),
