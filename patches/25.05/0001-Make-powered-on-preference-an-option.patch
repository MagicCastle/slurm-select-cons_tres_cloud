 <felix-antoine.fortin@calculquebec.ca>
Date: Mon, 6 Jul 2026 15:15:46 -0400
Subject: [PATCH 1/2] Make powered-on preference an option

---
 doc/man/man5/slurm.conf.5                 | 9 +++++++++
 slurm/slurm.h                             | 1 +
 src/common/read_config.c                  | 3 +++
 src/interfaces/select.c                   | 5 +++++
 src/plugins/data_parser/v0.0.41/parsers.c | 1 +
 src/plugins/data_parser/v0.0.42/parsers.c | 1 +
 src/plugins/data_parser/v0.0.43/parsers.c | 1 +
 7 files changed, 21 insertions(+)

diff --git a/doc/man/man5/slurm.conf.5 b/doc/man/man5/slurm.conf.5
index aaf7e44cc2..df524c9293 100644
--- a/doc/man/man5/slurm.conf.5
+++ b/doc/man/man5/slurm.conf.5
@@ -4889,6 +4889,15 @@ the first available device is used.
 This option is only supported by select/cons_tres plugin.
 .IP
 
+.TP
+\fBPreferPoweredUpNodes\fR
+With \fBSelectType=select/cons_tres\fR, prefer already powered-up nodes
+before considering nodes that need to be resumed. When enabled, job selection
+first tests nodes that are not powered down or powering up, then includes nodes
+that are powering up, and only falls back to powered-down or powering-down nodes
+if the job cannot otherwise be satisfied.
+.IP
+
 .TP
 \fBCR_Socket\fR
 Sockets are consumable resources.
diff --git a/slurm/slurm.h b/slurm/slurm.h
index 98df7a2df3..c0164bb567 100644
--- a/slurm/slurm.h
+++ b/slurm/slurm.h
@@ -1061,6 +1061,7 @@ enum node_states {
 /* was CR_OTHER_CONS_TRES   0x0800, removed v24.05 */
 /* By default, distribute cores using a block approach inside the nodes */
 #define CR_CORE_DEFAULT_DIST_BLOCK 0x1000
+#define SELECT_PREFER_POWERED_UP_NODES 0x2000 /* Prefer nodes already powered up */
 #define CR_LLN		0x4000  /* Select nodes by "least loaded." */
 #define MULTIPLE_SHARING_GRES_PJ 0x8000  /* Allow multiple sharing gres per job */
 
diff --git a/src/common/read_config.c b/src/common/read_config.c
index c9ad2cedf1..12f6d017a7 100644
--- a/src/common/read_config.c
+++ b/src/common/read_config.c
@@ -3555,6 +3555,9 @@ static int _parse_select_type_param(
 		} else if (!xstrcasecmp(str_parameters,
 				       "CR_CORE_DEFAULT_DIST_BLOCK")) {
 			*param |= CR_CORE_DEFAULT_DIST_BLOCK;
+		} else if (!xstrcasecmp(str_parameters,
+					"PreferPoweredUpNodes")) {
+			*param |= SELECT_PREFER_POWERED_UP_NODES;
 		} else if (!xstrcasecmp(str_parameters, "CR_LLN")) {
 			*param |= CR_LLN;
 		} else if (!xstrcasecmp(str_parameters, "CR_PACK_NODES")) {
diff --git a/src/interfaces/select.c b/src/interfaces/select.c
index bc27096ba9..83968dee80 100644
--- a/src/interfaces/select.c
+++ b/src/interfaces/select.c
@@ -199,6 +199,11 @@ extern char *select_type_param_string(uint16_t select_type_param)
 			strcat(select_str, ",");
 		strcat(select_str, "CR_CORE_DEFAULT_DIST_BLOCK");
 	}
+	if (select_type_param & SELECT_PREFER_POWERED_UP_NODES) {
+		if (select_str[0])
+			strcat(select_str, ",");
+		strcat(select_str, "PreferPoweredUpNodes");
+	}
 	if (select_type_param & CR_LLN) {
 		if (select_str[0])
 			strcat(select_str, ",");
