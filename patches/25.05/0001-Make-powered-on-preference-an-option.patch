--- a/src/plugins/data_parser/v0.0.41/parsers.c
+++ b/src/plugins/data_parser/v0.0.41/parsers.c
@@ -9240,6 +9240,7 @@ static const flag_bit_t PARSER_FLAG_ARRAY(CR_TYPE)[] = {
 	add_flag_bit(CR_ONE_TASK_PER_CORE, "ONE_TASK_PER_CORE"),
 	add_flag_bit(CR_PACK_NODES, "PACK_NODES"),
 	add_flag_bit(CR_CORE_DEFAULT_DIST_BLOCK, "CORE_DEFAULT_DIST_BLOCK"),
+	add_flag_bit(SELECT_PREFER_POWERED_UP_NODES, "PreferPoweredUpNodes"),
 	add_flag_bit(CR_LLN, "LLN"),
 	add_flag_bit(CR_LINEAR, "LINEAR"),
 };
